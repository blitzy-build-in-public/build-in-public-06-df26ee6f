# Environment variables the API process reads at startup. Every one has a default, so the
# application runs with no environment set. This file is a reference example and is not loaded
# automatically: the process reads process.env directly, and no secrets are read or required.

# Port the API binds (default 3000), and the target the frontend dev and preview servers proxy /api
# to. Export it before `npm run dev`, or set it in the Playwright webServer entry, to move both.
PORT=3000

# SQLite file to open (default ./data/todo.db), resolved against the process working directory; the
# parent directory is created when missing. Through the root scripts it resolves to
# backend/data/todo.db. Delete the file and its -wal/-shm sidecars to reset the data.
DATABASE_PATH=./data/todo.db

# Pino level for the Fastify logger (default info), and therefore for the cause logged with a 500
# response. The test suites pass silent so their output stays readable.
LOG_LEVEL=info
