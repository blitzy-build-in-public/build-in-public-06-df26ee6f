# Environment variables the tree reads: the three the API process reads at startup, and one that
# only the end-to-end harness reads. Every one has a default, so the application runs with no
# environment set. This file is a reference example and is not loaded automatically: the processes
# read process.env directly, and no secrets are read or required.

# Port the API binds (default 3000), and the target the frontend dev and preview servers proxy /api
# to. Export it before `npm run dev`, or set it in the Playwright webServer entry, to move both.
PORT=3000

# SQLite file to open (default ./data/todo.db), resolved against the process working directory; the
# parent directory is created when missing. Through the root scripts it resolves to
# backend/data/todo.db. Delete the file and its -wal/-shm sidecars to reset the data.
DATABASE_PATH=./data/todo.db

# Pino level for the Fastify logger (default info), and therefore for the cause logged with a 500
# response. The test suites pass silent so their output stays readable.
LOG_LEVEL=info

# --- Read by the end-to-end harness, not by the API process ---

# Port the Vite development server that `npm run test:e2e` starts listens on (default 5173), and
# therefore the run's baseURL. `playwright.config.ts` reads it and passes it to the server with
# `--port`; the API process never reads it. The `npm run dev` server is fixed at 5173 by
# frontend/vite.config.ts and moved with `--port` on its workspace script instead.
VITE_DEV_PORT=5173
